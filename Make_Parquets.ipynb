        "    negcon_count = df[col].astype(str).str.contains('negcon', case=False, na=False).sum()\n",
        "    dmso_count = df[col].astype(str).str.contains('dmso', case=False, na=False).sum()\n",
        "\n",
        "    if negcon_count > 0:\n",
        "        print(f\"   -> Found {negcon_count} row(s) with 'negcon' in '{col}'\")\n",
