      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "📂 Loading Sphered OpenPhenom embeddings from GCS...\n",
            "   ✅ Loaded 76,725 rows and 1,927 columns.\n",
            "\n",
            "🔍 Locating DMSO negative controls using chemical identifiers...\n",
            "   -> Found 8,404 DMSO control well(s).\n",
